# Copy this file to .env and fill in your keys. Never commit .env.

# https://console.groq.com/keys  (free tier, used for Whisper transcription)
GROQ_API_KEY=

# https://console.anthropic.com/settings/keys  (used for summarization)
ANTHROPIC_API_KEY=

# Model used to extract decisions / action items
CLAUDE_MODEL=claude-opus-5-5
